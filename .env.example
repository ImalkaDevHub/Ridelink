# Copy this file to .env and replace the value with a private random secret.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Account Service seeds this administrator on first startup.
ADMIN_EMAIL=admin@ridelink.local
ADMIN_PASSWORD=replace-this-with-a-unique-admin-password
