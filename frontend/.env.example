# Base URLs of the 4 backend services. These are called directly from the
# browser (no Next.js API proxy), so they must be reachable from wherever
# the frontend is opened, and each service's CORS config must allow this
# frontend's origin (see the CorsConfig class added to each service).
NEXT_PUBLIC_ACCOUNT_API_URL=http://localhost:8081
NEXT_PUBLIC_DRIVER_API_URL=http://localhost:8082
NEXT_PUBLIC_RIDE_API_URL=http://localhost:8083
NEXT_PUBLIC_FARE_API_URL=http://localhost:8084
