  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "1. Register Passenger",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"passengerToken\", pm.response.json().token);",
                  "pm.environment.set(\"passengerId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{accountUrl}}/api/auth/register",
              "host": [
                "{{accountUrl}}/api/auth/register"
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Pass\", \"email\": \"pass@a.com\", \"password\": \"pass\", \"role\": \"PASSENGER\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
